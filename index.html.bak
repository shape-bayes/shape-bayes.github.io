<!-- ================= THESIS + ABSTRACT + STATS ================= -->
<div class="wrap">
  <div class="thesis">
    <blockquote>Trust visual evidence where it is <span class="c-lik">reliable</span>. Rely on the shape prior where it is <span class="c-pri">ambiguous</span>.</blockquote>
    <cite>The core intuition of Shape-Bayes</cite>
  </div>

  <figure class="full arb" id="arbitration">
    <div class="sweep-scroll">
      <div class="arb-grid">
        <div></div>
        <div class="sh"><span class="sh-k"><i class="ln gold"></i>Deterministic regression</span><span class="badge">point estimate</span></div>
